# Copie para .env e ajuste. Nunca versione o .env.
# Os valores abaixo são exemplos de DESENVOLVIMENTO — não use em produção.

# --- PostgreSQL local (Docker, ver compose.yaml) ---
POSTGRES_USER=afinia
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_DB=afinia_dev
POSTGRES_TEST_DB=afinia_test
# Altere se a porta 5432 já estiver em uso no seu computador.
POSTGRES_PORT=5432

# --- Conexões usadas pelo Prisma ---
# Desenvolvimento local. Em produção (Vercel), use a URL *pooled* do provedor.
DATABASE_URL=postgresql://afinia:troque-esta-senha-local@127.0.0.1:5432/afinia_dev
# Opcional: URL direta (sem pooler) usada por `prisma migrate deploy`.
# Se vazia, DATABASE_URL é usada.
DIRECT_URL=
# Banco EXCLUSIVO dos testes automatizados. O nome precisa terminar em _test.
DATABASE_URL_TEST=postgresql://afinia:troque-esta-senha-local@127.0.0.1:5432/afinia_test

# --- Autenticação (Better Auth) ---
# Gere com: npx @better-auth/cli secret   (ou: openssl rand -base64 32)
BETTER_AUTH_SECRET=gere-um-segredo-aleatorio-com-32-caracteres-ou-mais
# URL pública do app (em produção: https://seu-dominio.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# --- Bootstrap do primeiro administrador (npm run bootstrap) ---
# Use uma senha temporária forte (mín. 12 caracteres); a troca é exigida no primeiro acesso.
# Remova estes valores do ambiente depois do bootstrap.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Opcional: cria também o casal do administrador.
BOOTSTRAP_HOUSEHOLD_NAME=
