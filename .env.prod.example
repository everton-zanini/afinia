# Copie para .env.prod (NÃO versionado). Usado somente pelos comandos `npm run prod:*`.
# Não é carregado pelo Next.js, pelo Prisma de desenvolvimento nem pelos testes.

# Prisma Postgres: connection string do console (aba "Connect" → conexão direta/TCP).
DATABASE_URL=
# Opcional: URL direta para migrations, se diferente da DATABASE_URL.
DIRECT_URL=
