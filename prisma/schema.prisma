generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Autenticação (estruturas exigidas pelo Better Auth)
// ---------------------------------------------------------------------------

model User {
  id                  String            @id
  name                String
  email               String            @unique
  emailVerified       Boolean           @default(false)
  image               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  // Administrador da plataforma: gerencia casais de teste; não concede acesso às finanças deles.
  isPlatformAdmin     Boolean           @default(false)
  // Senha temporária definida pelo administrador/bootstrap: troca obrigatória no próximo acesso.
  mustChangePassword  Boolean           @default(false)
  sessions            Session[]
  accounts            Account[]
  membership          HouseholdMember?
  createdTransactions Transaction[]     @relation("TransactionCreatedBy")
  createdSeries       RecurringSeries[] @relation("SeriesCreatedBy")
  createdPurchases    CardPurchase[]    @relation("PurchaseCreatedBy")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Rate limit nativo do Better Auth (por IP), persistido para funcionar em serverless.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// ---------------------------------------------------------------------------
// Casal (tenant)
// ---------------------------------------------------------------------------

// Invariante: todo dado financeiro pertence a exatamente um Household.
model Household {
  id               String             @id @default(cuid())
  name             String
  // Casal desativado: dados preservados, login e sessões dos membros bloqueados.
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  members          HouseholdMember[]
  categories       Category[]
  accounts         FinancialAccount[]
  transactions     Transaction[]
  budgets          Budget[]
  recurringSeries  RecurringSeries[]
  creditCards      CreditCard[]
  cardInvoices     CardInvoice[]
  cardPurchases    CardPurchase[]
  cardInstallments CardInstallment[]

  @@map("household")
}

// Invariantes: um casal por usuário (userId único); no máximo 2 membros ativos por casal
// (garantido em src/server/households/members.ts, único ponto que cria vínculos).
model HouseholdMember {
  id                   String          @id @default(cuid())
  householdId          String
  userId               String          @unique
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now())
  household            Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  responsibleFor       Transaction[]
  responsibleRules     RecurringRule[]
  heldCards            CreditCard[]    @relation("CardHolder")
  responsiblePurchases CardPurchase[]  @relation("PurchaseResponsible")

  @@index([householdId, active])
  @@map("household_member")
}

// ---------------------------------------------------------------------------
// Finanças do casal
//
// Invariantes garantidas no banco (SQL na migration `finance_core`):
// - Gatilhos recusam referências (categoria, conta, membro, categoria-pai) de outro casal.
// - CHECKs: valor > 0 e ≤ R$ 10 mi; efetivado ⇔ tem data de efetivação; transferência ⇔
//   tem conta destino ≠ origem e não tem categoria; limite de orçamento > 0; mês YYYY-MM.
// Dinheiro sempre em centavos inteiros; datas de calendário em colunas DATE.
// ---------------------------------------------------------------------------

enum CategoryKind {
  INCOME
  EXPENSE
}

// "Categorias" na interface: compõem o plano de contas (finalidade da receita/despesa).
model Category {
  id            String          @id @default(cuid())
  householdId   String
  parentId      String?
  kind          CategoryKind
  name          String
  color         String
  icon          String
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  household     Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  parent        Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[]      @relation("CategoryTree")
  transactions  Transaction[]
  budgets       Budget[]
  rules         RecurringRule[]
  cardPurchases CardPurchase[]

  @@index([householdId, kind])
  @@index([parentId])
  @@map("category")
}

enum AccountKind {
  CHECKING
  CASH
  RESERVE
  // Cartão pré-pago (vale-alimentação, refeição, combustível): sem fatura nem transferências.
  BENEFIT
}

// Finalidade informativa do benefício (não bloqueia lançamentos).
enum BenefitPurpose {
  FOOD
  MEAL
  MOBILITY
  FLEXIBLE
  OTHER
}

// Conta financeira: onde o dinheiro está. O saldo inicial é posição de abertura, não receita.
model FinancialAccount {
  id                  String          @id @default(cuid())
  householdId         String
  name                String
  kind                AccountKind
  // Obrigatória só para BENEFIT (CHECK na migration `benefit_accounts`).
  benefitPurpose      BenefitPurpose?
  openingBalanceCents Int
  openingDate         DateTime        @db.Date
  archivedAt          DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  household           Household       @relation(fields: [householdId], references: [id], onDelete: Restrict)
  outgoing            Transaction[]   @relation("TransactionAccount")
  incoming            Transaction[]   @relation("TransactionToAccount")
  ruleOutgoing        RecurringRule[] @relation("RuleAccount")
  ruleIncoming        RecurringRule[] @relation("RuleToAccount")
  cardsPaidFrom       CreditCard[]    @relation("CardPaymentAccount")

  @@index([householdId])
  @@map("financial_account")
}

enum TransactionKind {
  INCOME
  EXPENSE
  TRANSFER
  // Pagamento de fatura de cartão: sai da conta de origem, nunca é despesa por categoria.
  CARD_PAYMENT
}

enum TransactionStatus {
  PENDING
  EFFECTIVE
}

// Transferência = um único registro (origem accountId, destino toAccountId): atômica por construção.
model Transaction {
  id                  String            @id @default(cuid())
  householdId         String
  kind                TransactionKind
  status              TransactionStatus
  description         String
  amountCents         Int
  categoryId          String?
  accountId           String
  toAccountId         String?
  dueDate             DateTime          @db.Date
  effectiveDate       DateTime?         @db.Date
  responsibleMemberId String?
  notes               String?
  createdById         String
  // Gerada pelo formulário ao abrir: reenvios com a mesma chave não duplicam o lançamento.
  idempotencyKey      String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  household           Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account             FinancialAccount  @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount           FinancialAccount? @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  responsibleMember   HouseholdMember?  @relation(fields: [responsibleMemberId], references: [id], onDelete: Restrict)
  createdBy           User              @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  // Ocorrência de recorrência: identidade estável pela posição (independe da data prevista).
  // Definidos só pelo servidor ao gerar; seriesOverride = personalizada com "Só este lançamento".
  seriesId            String?
  occurrenceIndex     Int?
  seriesOverride      Boolean           @default(false)
  series              RecurringSeries?  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  // Somente CARD_PAYMENT: fatura paga por este lançamento.
  invoiceId           String?
  invoice             CardInvoice?      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([householdId, idempotencyKey])
  @@unique([seriesId, occurrenceIndex])
  @@index([invoiceId])
  @@index([householdId, effectiveDate])
  @@index([householdId, dueDate])
  @@index([householdId, accountId])
  @@index([householdId, toAccountId])
  @@index([householdId, categoryId])
  @@map("financial_transaction")
}

// Limite mensal por categoria principal de despesa.
model Budget {
  id          String    @id @default(cuid())
  householdId String
  month       String    @db.Char(7)
  categoryId  String
  limitCents  Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  household   Household @relation(fields: [householdId], references: [id], onDelete: Restrict)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([householdId, month, categoryId])
  @@map("budget")
}

// ---------------------------------------------------------------------------
// Recorrências (definição separada dos lançamentos; ocorrências são lançamentos comuns)
// Invariantes no banco (migration `recurring_transactions`): uma ocorrência por posição,
// gatilhos de isolamento entre casais, CHECKs de forma/valor e de término.
// ---------------------------------------------------------------------------

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum RecurrenceEndMode {
  COUNT
  UNTIL
  NONE
}

model RecurringSeries {
  id                    String               @id @default(cuid())
  householdId           String
  // Imutáveis após a criação: para mudá-los, encerra-se a série e cria-se outra.
  kind                  TransactionKind
  frequency             RecurrenceFrequency
  startDate             DateTime             @db.Date
  endMode               RecurrenceEndMode
  occurrenceCount       Int?
  untilDate             DateTime?            @db.Date
  // "Excluir este e os próximos": programação termina antes desta posição.
  stopBeforeIndex       Int?
  // "Encerrar recorrência": nenhuma posição com data prevista ≥ esta data.
  stoppedOn             DateTime?            @db.Date
  // Maior posição já avaliada pela geração (otimização; a unicidade garante a correção).
  generatedThroughIndex Int                  @default(-1)
  // Destino em cartão (só despesas; imutável). As ocorrências viram previsões de cobrança.
  cardId                String?
  card                  CreditCard?          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  cardForecasts         CardPurchase[]
  createdById           String
  idempotencyKey        String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  household             Household            @relation(fields: [householdId], references: [id], onDelete: Restrict)
  createdBy             User                 @relation("SeriesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  rules                 RecurringRule[]
  exceptions            RecurringException[]
  occurrences           Transaction[]

  @@unique([householdId, idempotencyKey])
  @@index([householdId])
  @@map("recurring_series")
}

// Regra da série vigente a partir de uma posição (a de maior fromIndex ≤ posição).
model RecurringRule {
  id                  String            @id @default(cuid())
  seriesId            String
  fromIndex           Int
  description         String
  amountCents         Int
  categoryId          String?
  // Nulo somente em séries com destino em cartão (garantido por gatilho).
  accountId           String?
  toAccountId         String?
  responsibleMemberId String?
  notes               String?
  createdAt           DateTime          @default(now())
  series              RecurringSeries   @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  account             FinancialAccount? @relation("RuleAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount           FinancialAccount? @relation("RuleToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  responsibleMember   HouseholdMember?  @relation(fields: [responsibleMemberId], references: [id], onDelete: Restrict)

  @@unique([seriesId, fromIndex])
  @@map("recurring_rule")
}

// Posição excluída individualmente: nunca é gerada de novo.
model RecurringException {
  seriesId        String
  occurrenceIndex Int
  createdAt       DateTime        @default(now())
  series          RecurringSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@id([seriesId, occurrenceIndex])
  @@map("recurring_exception")
}

// ---------------------------------------------------------------------------
// Cartões de crédito (controle manual). Nenhum número completo, CVV ou credencial.
// Invariantes no banco (migration `credit_cards`): isolamento entre casais, fatura e parcela
// do mesmo cartão da compra, benefício nunca paga fatura, valores e dias válidos.
// ---------------------------------------------------------------------------

model CreditCard {
  id               String            @id @default(cuid())
  householdId      String
  name             String
  issuer           String?
  lastFour         String?           @db.Char(4)
  color            String
  limitCents       Int
  // Valem para faturas criadas depois de alterados; faturas gravadas mantêm suas datas.
  closingDay       Int
  dueDay           Int
  // Titular informativo: os dois membros gerenciam o cartão.
  holderMemberId   String
  paymentAccountId String?
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  household        Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  holder           HouseholdMember   @relation("CardHolder", fields: [holderMemberId], references: [id], onDelete: Restrict)
  paymentAccount   FinancialAccount? @relation("CardPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  invoices         CardInvoice[]
  purchases        CardPurchase[]
  series           RecurringSeries[]

  @@index([householdId])
  @@map("credit_card")
}

// Fatura com identidade estável e datas gravadas na criação (nunca recalculadas).
model CardInvoice {
  id           String            @id @default(cuid())
  householdId  String
  cardId       String
  periodStart  DateTime          @db.Date
  closingDate  DateTime          @db.Date
  dueDate      DateTime          @db.Date
  createdAt    DateTime          @default(now())
  household    Household         @relation(fields: [householdId], references: [id], onDelete: Restrict)
  card         CreditCard        @relation(fields: [cardId], references: [id], onDelete: Restrict)
  installments CardInstallment[]
  purchases    CardPurchase[]
  payments     Transaction[]

  @@unique([cardId, closingDate])
  @@index([householdId, dueDate])
  @@map("card_invoice")
}

enum CardPurchaseStatus {
  // Previsão de cobrança recorrente: não afeta saldo nem limite.
  FORECAST
  CONFIRMED
}

// Compra original (à vista ou parcelada) ou previsão de cobrança de recorrência no cartão.
model CardPurchase {
  id                  String             @id @default(cuid())
  householdId         String
  cardId              String
  status              CardPurchaseStatus
  description         String
  totalCents          Int
  purchaseDate        DateTime           @db.Date
  categoryId          String
  responsibleMemberId String?
  notes               String?
  installmentCount    Int                @default(1)
  // Fatura inicial (compra) ou sugerida (previsão).
  invoiceId           String
  createdById         String
  idempotencyKey      String
  seriesId            String?
  occurrenceIndex     Int?
  seriesOverride      Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  household           Household          @relation(fields: [householdId], references: [id], onDelete: Restrict)
  card                CreditCard         @relation(fields: [cardId], references: [id], onDelete: Restrict)
  category            Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  responsibleMember   HouseholdMember?   @relation("PurchaseResponsible", fields: [responsibleMemberId], references: [id], onDelete: Restrict)
  invoice             CardInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  createdBy           User               @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  series              RecurringSeries?   @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  installments        CardInstallment[]

  @@unique([householdId, idempotencyKey])
  @@unique([seriesId, occurrenceIndex])
  @@index([householdId, cardId])
  @@map("card_purchase")
}

// Parcela: posição, valor exato em centavos e fatura em que é cobrada.
model CardInstallment {
  id          String       @id @default(cuid())
  householdId String
  purchaseId  String
  invoiceId   String
  index       Int
  amountCents Int
  createdAt   DateTime     @default(now())
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Restrict)
  purchase    CardPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  invoice     CardInvoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([purchaseId, index])
  @@index([invoiceId])
  @@map("card_installment")
}

// Limitação de tentativas de login por email (regra do Afinia).
model LoginThrottle {
  key         String    @id
  failures    Int
  windowStart DateTime
  lockedUntil DateTime?

  @@map("login_throttle")
}
