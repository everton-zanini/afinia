{
  "name": "afinia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:test:migrate": "tsx scripts/with-test-db.ts prisma migrate deploy",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:seed:categories": "tsx scripts/seed-categories.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "icons": "node scripts/generate-icons.mjs",
    "prod:status": "tsx scripts/with-prod-db.ts prisma migrate status",
    "prod:migrate": "tsx scripts/with-prod-db.ts --write prisma migrate deploy",
    "prod:studio": "tsx scripts/with-prod-db.ts --write prisma studio",
    "prod:bootstrap": "tsx scripts/with-prod-db.ts --write tsx scripts/bootstrap.ts",
    "prod:reset-password": "tsx scripts/with-prod-db.ts --write tsx scripts/reset-password.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "npm run db:test:migrate && tsx scripts/with-test-db.ts vitest run --project integration",
    "e2e": "npm run db:test:migrate && npm run build && tsx scripts/with-test-db.ts playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10",
    "@prisma/client": "7.10",
    "better-auth": "1.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "prisma": "7.10",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
